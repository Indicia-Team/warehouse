/**
 * To build a table that facilites building reports which help users to find
 * groups (e.g. activities or projects) that have similar geographic or
 * taxonomic coverage as their own records:
 * 1. Copy this file and rename to `discover_groups.php`.
 * 2. Identify a location type that is handled by the `spatial_index_builder`
 *    module that you would like to use for geographic comparison. Should be
 *    small enough so that a polygon is not larger than the area you would like
 *    to suggest recorders travel to for their group activities.
 * 3. Ensure that the `custom_cache_tables` warehouse module is enabled.
 */

/**
 * Get metadata about running the process that builds the table.
 */
function get_discover_groups_metadata() {
  return array(
    'frequency' => '1 day',
    'autodrop' => FALSE,
  );
}

/**
 * Returns the query used to generate the index_group_discovery table.
 */
function get_discover_groups_query($db) {
  // Set to the location type to be used for geographic comparison - should be
  // selected from spatial_index_builder config `group_location_types` setting.
  $locationType = 'Vice County';
  $locationTypeId = $db->query("select id from cache_termlists_terms where termlist_title='Location types' and term=?", $locationType)->current()->id;

  return <<<SQL
    drop table if exists custom_cache_tables.index_group_discovery_build;

    WITH eligible_groups AS (
      SELECT g.id, g.website_id
      FROM groups g
      JOIN filters f ON f.id = g.filter_id AND f.deleted = false
      WHERE g.deleted = false
        AND g.joining_method IN ('P', 'R')
        AND (g.to_date IS NULL OR g.to_date > now() - '1 day'::interval)
        AND (g.from_date IS NULL OR g.from_date < now() + '5 days'::interval)
    ),
    location_stats AS (
      SELECT
        gl.group_id,
        array_agg(DISTINCT gl.location_id)
          FILTER (WHERE gl.location_type_id = $locationTypeId) AS location_ids,
        count(DISTINCT gl.location_id)
          FILTER (WHERE gl.location_type_id = $locationTypeId) AS location_count
      FROM index_groups_locations gl
      JOIN eligible_groups g ON g.id = gl.group_id
      GROUP BY gl.group_id
    ),
    taxon_stats AS (
      SELECT
        gtg.group_id,
        array_agg(DISTINCT gtg.taxon_group_id) AS taxon_group_ids,
        count(DISTINCT gtg.taxon_group_id) AS taxon_group_count
      FROM index_groups_taxon_groups gtg
      JOIN eligible_groups g ON g.id = gtg.group_id
      GROUP BY gtg.group_id
    ),
    occurrence_stats AS (
      SELECT
        o.group_id,
        count(*) AS recent_records,
        count(*) FILTER (
          WHERE o.created_on > now() - interval '2 days'
        ) AS recent_records_2_days
      FROM cache_occurrences_functional o
      JOIN eligible_groups g ON g.id = o.group_id
      WHERE o.created_on > now() - interval '1 year'
      GROUP BY o.group_id
    )
    SELECT
      g.id AS group_id,
      g.website_id,
      ls.location_ids AS group_indexed_location_ids,
      coalesce(ls.location_count, 0) AS group_indexed_location_ids_count,
      coalesce(ts.taxon_group_ids, '{}'::integer[])
        AS group_indexed_taxon_group_ids,
      coalesce(ts.taxon_group_count, 0)
        AS group_indexed_taxon_group_ids_count,
      coalesce(os.recent_records, 0) AS group_recent_records,
      coalesce(os.recent_records_2_days, 0)
        AS group_recent_records_2_days
    INTO custom_cache_tables.index_group_discovery_build
    FROM eligible_groups g
    LEFT JOIN location_stats ls ON ls.group_id = g.id
    LEFT JOIN taxon_stats ts ON ts.group_id = g.id
    LEFT JOIN occurrence_stats os ON os.group_id = g.id;

    -- Tidy nulls from arrays.
    update custom_cache_tables.index_group_discovery_build set group_indexed_taxon_group_ids='{}' where group_indexed_taxon_group_ids=array[null]::integer[];

    grant select on custom_cache_tables.index_group_discovery_build to indicia_report_user;

    drop table if exists custom_cache_tables.index_group_discovery;
    alter table custom_cache_tables.index_group_discovery_build rename to index_group_discovery;
  SQL;
}